# Default landing route: "/" renders TemplateShowcase (reference root) or "/home" for Fintech Homepage
VITE_DEFAULT_ROUTE=/

# Configurable contact & support destinations
VITE_SUPPORT_EMAIL=support@flowswipe.com
VITE_LOGIN_URL=/contact
VITE_APP_DOWNLOAD_URL=/features

# Optional authorized form backend endpoints (leave blank to use documented local dev adapter)
VITE_CONTACT_FORM_ENDPOINT=
VITE_CARD_ALERT_ENDPOINT=
VITE_CAREER_APPLY_ENDPOINT=
